FRONTEND_ORIGIN=http://localhost:3000

# MongoDB Atlas connection. Never commit a real URI.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=trafficflow_ai

# Use a random value containing at least 32 characters.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_MINUTES=480

# Hosted object detection (keeps PyTorch/Ultralytics out of Vercel).
HF_TOKEN=hf_your_token_here
HF_MODEL=facebook/detr-resnet-50
HF_ENDPOINT=https://router.huggingface.co/hf-inference/models
DETECTION_THRESHOLD=0.55
MAX_SAMPLED_FRAMES=4

# Optional: hosts accepted by /api/analyze-video-url, separated by commas.
# Example: abc.public.blob.vercel-storage.com,res.cloudinary.com
VIDEO_HOST_ALLOWLIST=
MAX_REMOTE_VIDEO_MB=50

# Optional values used locally by: python -m app.seed_admin
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

